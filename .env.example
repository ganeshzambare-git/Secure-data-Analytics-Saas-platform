# ============================================================
# ReadyNest Analytics Engine — Environment Configuration
# Copy this file to .env and replace values with production secrets
# NEVER commit .env to version control
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@db:5432/readynest

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- AES-256-GCM Encryption Key (MUST be exactly 32 characters) -----
AES_SECRET_KEY=CHANGE_ME_TO_32_CHAR_RANDOM_KEY!!

# ----- JWT Secret (minimum 32 characters recommended) -----
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_JWT_SECRET_KEY_HERE

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AES_SECRET_KEY=CHANGE_ME_TO_32_CHAR_RANDOM_KEY!!
